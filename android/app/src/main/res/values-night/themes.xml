<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark platform theme: the page's own dark palette applies through
         prefers-color-scheme (no algorithmic darkening). -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
